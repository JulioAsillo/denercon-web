---
// src/components/CertificationsBanner.astro
// Componente especializado para destacar certificaciones en la página de cortafuego
import { certificationsByCategory } from '../data/certifications';

interface Props {
  highlight?: 'fire' | 'hardware' | 'all';
}

const { highlight = 'fire' } = Astro.props;

// Seleccionar certificaciones según categoría
const displayCerts =
  highlight === 'all'
    ? Object.values(certificationsByCategory).flat()
    : certificationsByCategory[highlight] || certificationsByCategory.fire;
---

<div class="certifications-banner">
  <div class="container mx-auto px-4">
    <div class="banner-content">
      <div class="banner-text">
        <h3 class="banner-title">
          Cumplimiento Internacional
        </h3>
        <p class="banner-description">
          Nuestros sistemas de puertas cortafuego cumplen con las certificaciones más exigentes a nivel mundial.
        </p>
      </div>

      <div class="certs-display">
        {displayCerts.map((cert) => (
          <div key={cert.id} class="cert-badge">
            <img
              src={cert.imageUrl}
              alt={cert.altText}
              title={cert.name}
              class="cert-badge-image"
            />
            <span class="cert-badge-name">{cert.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .certifications-banner {
    background: linear-gradient(
      135deg,
      var(--color-navy-900) 0%,
      var(--color-blue) 100%
    );
    color: white;
    padding: 40px 0;
    margin: 48px 0;
  }

  .banner-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .banner-text h3 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .banner-description {
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.95;
  }

  .certs-display {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .cert-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 16px;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .cert-badge:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-4px);
  }

  .cert-badge-image {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .cert-badge-name {
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .banner-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .banner-text h3 {
      font-size: 24px;
    }

    .certs-display {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .cert-badge {
      padding: 12px;
    }

    .cert-badge-image {
      width: 40px;
      height: 40px;
    }

    .cert-badge-name {
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .certifications-banner {
      padding: 32px 0;
      margin: 32px 0;
    }

    .banner-text h3 {
      font-size: 20px;
    }

    .banner-description {
      font-size: 14px;
    }

    .certs-display {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .cert-badge {
      padding: 10px;
    }
  }
</style>
