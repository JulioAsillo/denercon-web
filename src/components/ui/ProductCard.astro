---
import { Image } from "astro:assets";
import type { Product } from "@data/products";
import WhatsAppButton from "@components/ui/WhatsAppButton.astro";

interface Props {
  product: Product;
  accent?: "blue" | "fire";
}
const { product, accent = "blue" } = Astro.props;
const iconColor = accent === "fire" ? "text-fire" : "text-blue";
const cardBg = accent === "fire" ? "bg-fire-soft border-fire/20" : "bg-white border-navy/10";
const badgeBg = accent === "fire" ? "bg-fire" : "bg-navy";

const colors = product.colors ?? [];
const hasCarousel = colors.length > 0;
---

{hasCarousel ? (
  <article
    class={`rounded-brand border ${cardBg} overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col group`}
    data-color-carousel
  >
    <!-- Media: imagen grande del color activo -->
    <div class="relative aspect-[4/5] w-full overflow-hidden bg-navy">
      {colors.map((c, i) => (
        <div class={`cc-slide absolute inset-0 transition-opacity duration-500 ${i === 0 ? "opacity-100" : "opacity-0"}`} data-label={c.label}>
          <Image
            src={c.src}
            alt={`${product.title} — ${c.label}`}
            widths={[480, 720, 1000, 1400]}
            sizes="(max-width: 768px) 90vw, (max-width: 1536px) 33vw, 460px"
            loading={i === 0 ? "eager" : "lazy"}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
      <div class="absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-navy/70 to-transparent pointer-events-none"></div>
      <span class="cc-label absolute left-3 bottom-3 z-10 text-white text-sm font-semibold px-3 py-1 rounded-full bg-navy/70 backdrop-blur-sm">
        {colors[0].label}
      </span>
      {product.badge && (
        <span class={`absolute top-3 right-3 z-10 ${badgeBg} text-white text-xs font-bold px-2.5 py-1 rounded shadow`}>{product.badge}</span>
      )}
    </div>

    <!-- Grilla de colores: todas las muestras visibles con su nombre -->
    {colors.length > 1 && (
      <div class="px-4 pt-4">
        <div class="grid grid-cols-5 gap-2">
          {colors.map((c, i) => (
            <button
              type="button"
              class={`cc-thumb group/thumb flex flex-col items-center gap-1 rounded-lg p-1 transition ${i === 0 ? "ring-2 ring-blue" : "ring-1 ring-navy/10 hover:ring-navy/30"}`}
              data-index={i}
              aria-label={`Ver ${c.label}`}
            >
              <span class="block w-full aspect-square overflow-hidden rounded-md bg-navy/5">
                <Image
                  src={c.src}
                  alt={`${product.title} — ${c.label}`}
                  widths={[120, 240]}
                  sizes="80px"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </span>
              <span class="cc-thumb-label text-[10px] leading-tight text-center text-navy/70 line-clamp-2">{c.label}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Contenido -->
    <div class="p-6 flex-1 flex flex-col">
      <h3 class="text-xl font-bold text-navy mb-1">{product.title}</h3>
      {product.subtitle && <p class="text-sm text-blue font-medium mb-4">{product.subtitle}</p>}
      <ul class="space-y-2 mb-6 flex-1 text-sm text-navy/70">
        {product.features.map((f) => (
          <li class="flex items-start gap-2">
            <span class={`material-symbols-outlined text-[18px] ${iconColor}`}>{f.icon}</span>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
      <WhatsAppButton message={product.waMessage} label={product.ctaLabel} full class="mt-auto" />
    </div>
  </article>
) : (
  <article class={`rounded-brand border ${cardBg} overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow group`}>
    <div class="relative h-56 overflow-hidden">
      <Image
        src={product.image}
        alt={product.alt}
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      {product.badge && (
        <span class={`absolute top-2 right-2 ${badgeBg} text-white text-xs font-bold px-2 py-1 rounded shadow`}>{product.badge}</span>
      )}
    </div>
    <div class="p-6 flex-1 flex flex-col">
      <h3 class="text-xl font-bold text-navy mb-1">{product.title}</h3>
      {product.subtitle && <p class="text-sm text-blue font-medium mb-4">{product.subtitle}</p>}
      <ul class="space-y-2 mb-8 flex-1 text-sm text-navy/70">
        {product.features.map((f) => (
          <li class="flex items-start gap-2">
            <span class={`material-symbols-outlined text-[18px] ${iconColor}`}>{f.icon}</span>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
      <WhatsAppButton message={product.waMessage} label={product.ctaLabel} full class="mt-auto" />
    </div>
  </article>
)}

<script>
  function initColorGrids() {
    document.querySelectorAll<HTMLElement>("[data-color-carousel]").forEach((card) => {
      // Evita doble inicializacion en navegaciones con View Transitions
      if (card.dataset.ccReady === "1") return;
      card.dataset.ccReady = "1";

      const slides = Array.from(card.querySelectorAll<HTMLElement>(".cc-slide"));
      const thumbs = Array.from(card.querySelectorAll<HTMLButtonElement>(".cc-thumb"));
      const label = card.querySelector<HTMLElement>(".cc-label");
      if (slides.length === 0) return;

      const go = (i: number) => {
        const current = (i + slides.length) % slides.length;
        slides.forEach((s, idx) => {
          s.classList.toggle("opacity-100", idx === current);
          s.classList.toggle("opacity-0", idx !== current);
        });
        thumbs.forEach((t, idx) => {
          const active = idx === current;
          t.classList.toggle("ring-2", active);
          t.classList.toggle("ring-blue", active);
          t.classList.toggle("ring-1", !active);
          t.classList.toggle("ring-navy/10", !active);
        });
        if (label) label.textContent = slides[current].dataset.label ?? "";
      };

      // Clic (o foco por teclado) en una miniatura -> cambia la imagen grande
      thumbs.forEach((t) => {
        const idx = Number(t.dataset.index ?? "0");
        t.addEventListener("click", () => go(idx));
        t.addEventListener("mouseenter", () => go(idx));
      });
    });
  }
  initColorGrids();
  document.addEventListener("astro:page-load", initColorGrids);
</script>
